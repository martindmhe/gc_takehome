# Placeholder configuration: copy to .env for local 
#
# values committed on purpose since app has no third-party services, API keys or real secrets yet

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=leads
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=leads
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# Must match the PostgreSQL values above.
DATABASE_URL=postgresql+psycopg://leads:change-me-local-only@localhost:5432/leads
SQL_ECHO=false
# Uploaded PDFs are stored here, outside any public web directory (default: backend/var/uploads).
# STORAGE_DIR=/absolute/path/to/uploads
# Largest accepted upload, in bytes (default 10 MB).
MAX_UPLOAD_BYTES=10485760

# --- Frontend dev server ---
# Vite proxies /api/* to this address.
VITE_API_PROXY_TARGET=http://localhost:8000
